{
  "name": "sheets-editor",
  "version": "1.0.0",
  "description": "Google Sheets GUI Editor - 링크 공유만으로 누구나 수정 가능",
  "main": "server.js",
  "scripts": {
    "start": "node server.js",
    "dev": "npx nodemon server.js",
    "recommend": "node stock/app.js once-quiet",
    "schedule": "node stock/app.js schedule",
    "stock:test": "node stock/selftest.js",
    "build:exe": "pkg . --targets node22-win-x64 --output dist/stock-recommend.exe"
  },
  "bin": "stock/app.js",
  "pkg": {
    "scripts": [
      "stock/**/*.js"
    ],
    "targets": [
      "node22-win-x64"
    ],
    "outputPath": "dist"
  },
  "dependencies": {
    "express": "^4.18.2",
    "googleapis": "^140.0.0",
    "node-cron": "^3.0.3"
  },
  "devDependencies": {
    "@yao-pkg/pkg": "^6.21.0"
  }
}
